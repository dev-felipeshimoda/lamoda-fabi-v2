rules_version = '2';

// MVP — single user (felipeshimoda@outlook.com).
service firebase.storage {
  match /b/{bucket}/o {

    function isOwner() {
      return request.auth != null
          && request.auth.token.email == 'felipeshimoda@outlook.com';
    }

    // Limite default: 10 MB por upload (xlsx + fotos).
    match /{path=**} {
      allow read:  if isOwner();
      allow write: if isOwner() && request.resource.size < 10 * 1024 * 1024;
    }
  }
}
